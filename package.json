{
  "name": "proofsheet",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @proofsheet/web dev",
    "dev:worker": "pnpm --filter @proofsheet/worker dev",
    "build": "turbo build",
    "db:migrate": "pnpm --filter @proofsheet/db migrate",
    "db:seed": "pnpm --filter @proofsheet/db seed",
    "db:push": "pnpm --filter @proofsheet/db push",
    "local": "docker compose up -d --wait && pnpm db:migrate && pnpm db:seed && turbo dev",
    "test": "pnpm --filter @proofsheet/web test && pnpm --filter @proofsheet/interfaze test",
    "test:e2e": "pnpm --filter @proofsheet/web test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.9.2"
  }
}
