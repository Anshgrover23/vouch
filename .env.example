# Copy to .env.local — never commit secrets.

# Required for local Postgres (docker compose)
DATABASE_URL=postgres://proofsheet:proofsheet@localhost:5432/proofsheet
SESSION_SECRET=change-me-to-a-long-random-string

# Interfaze — live OCR. Leave empty to use fixtures.
INTERFAZE_API_KEY=
# Force fixtures even if a key is present
PROOFSHEET_FIXTURE=0

# Optional: Python eval sidecar
EVAL_URL=http://127.0.0.1:8090

# Optional: Supabase (real auth + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Stripe test mode
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Public app URL (Stripe redirects, GraphQL playground)
NEXT_PUBLIC_APP_URL=http://localhost:3000
