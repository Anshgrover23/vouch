# Copy to .env.local — never commit secrets.

# Local Docker Postgres (`pnpm local`). On Vercel, paste the pooled Supabase/Neon URI.
DATABASE_URL=postgres://proofsheet:proofsheet@localhost:5432/proofsheet

# Signs the demo session cookie. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Interfaze live OCR. Empty → fixture receipts.
INTERFAZE_API_KEY=

# Set 1 to force fixtures even with a key.
PROOFSHEET_FIXTURE=0

# Public URL of the app (local or https://vouch.anshgrover.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000
